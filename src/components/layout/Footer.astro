---
import { translations } from '../../i18n/translations';

interface Props {
  lang?:  keyof typeof translations;
}

const { lang = 'fr' } = Astro.props as Props;
const year = new Date().getFullYear();
const t = translations[lang];
---

<footer class="footer">
  <div class="container">
    <div class="relative flex-center">
      <a href="https://nocdev.fr" target="_blank" rel="noopener noreferrer">
        <img src="/logo.svg" alt="Nocdev logo" class="footer-logo" width="60" height="60" />
      </a>
    </div>

    <div class="flex ai-center jc-between gap-4 text-sm">
      <a href="/legal" class="footer-link text-sm ink-1">{t.legal}</a>
      <p class="footer-copy text-sm font-bold uppercase ink-1">© {year} Nocdev</p>
    </div>
  </div>
</footer>
